{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow",
  },
  "plugin": [
    // "opencode-agent-memory",
    // "oh-my-opencode@latest",
    // "superpowers@git+https://github.com/obra/superpowers.git",
  ],
  "mcp": {
    "figma": {
      "type": "local",
      "command": ["npx", "-y", "@yhy2001/figma-mcp-server", "--stdio"],
      "environment": {
        "FIGMA_API_KEY": "{env:FIGMA_API_KEY}",
      },
      "enabled": true,
    },
    "figma-write": {
      "type": "local",
      "command": ["node", "/Users/ahmed.rezk/.config/opencode/mcp-servers/figma-write/mcp/dist/index.js"],
      "enabled": true,
    },
    "jira": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "enabled": false,
    },
    "jira-server": {
      "type": "local",
      "command": ["npx", "mcp-atlassian"],
      "environment": {
        "JIRA_URL": "https://jira.cengage.com",
        "JIRA_API_TOKEN": "{env:JIRA_TOKEN}",
        "JIRA_PERSONAL_TOKEN": "{env:JIRA_TOKEN}",
        "JIRA_USERNAME": "arezk48437",
      },
      "enabled": false,
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true,
    },
    "bitbucket": {
      "type": "local",
      "command": ["node", "/Users/ahmed.rezk/.config/opencode/mcp-servers/bitbucket-server/build/index.js"],
      "environment": {
        "BITBUCKET_URL": "{env:BITBUCKET_URL}",
        "BITBUCKET_USERNAME": "{env:BITBUCKET_USERNAME}",
        "BITBUCKET_PASSWORD": "{env:BITBUCKET_PASSWORD}",
        "BITBUCKET_DEFAULT_PROJECT": "{env:BITBUCKET_DEFAULT_PROJECT}",
      },
      "enabled": true,
    },
  },
  // "provider": {
