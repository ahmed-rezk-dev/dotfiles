#!/usr/bin/env bash
# One-shot setup for a fresh macOS machine. Idempotent: every step skips if already done.
# Usage: ./bootstrap            run everything
#        DRY_RUN=1 ./bootstrap  print what would run

set -euo pipefail

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${BASEDIR}"

run() {
  if [ -n "${DRY_RUN:-}" ]; then
    echo "[dry-run] $*"
  else
    "$@"
  fi
}
step() { printf '\n==> %s\n' "$1"; }
have() { command -v "$1" >/dev/null 2>&1; }

if [ "$(uname -s)" != "Darwin" ]; then
  echo "bootstrap supports macOS only (Brewfile has casks)." >&2
  exit 1
fi

step "Xcode command line tools"
if xcode-select -p >/dev/null 2>&1; then
  echo "already installed"
else
  run xcode-select --install
  if [ -z "${DRY_RUN:-}" ]; then
    echo "Waiting for the installer to finish..."
    until xcode-select -p >/dev/null 2>&1; do sleep 5; done
  fi
fi

step "Homebrew"
if have brew; then
  echo "already installed"
else
  run /bin/bash -c "NONINTERACTIVE=1 $(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
for prefix in /opt/homebrew /usr/local; do
  if [ -x "${prefix}/bin/brew" ]; then
    eval "$("${prefix}/bin/brew" shellenv)"
    break
  fi
done

step "Brewfile packages"
# Recent brew refuses formulae from untrusted taps; trust the ones this Brewfile declares.
while read -r tap; do
  run brew tap "${tap}"
  run brew trust "${tap}" 2>/dev/null || true
done < <(sed -n 's/^tap "\([^"]*\)".*/\1/p' Brewfile)
run brew bundle --file="${BASEDIR}/Brewfile"

step "bun"
if have bun || [ -x "${HOME}/.bun/bin/bun" ]; then
  echo "already installed"
else
  run /bin/bash -c "$(curl -fsSL https://bun.sh/install)"
fi
export PATH="${HOME}/.bun/bin:${PATH}"

step "omp (agent CLI)"
if have omp; then
  echo "already installed"
else
  run bun install -g @oh-my-pi/pi-coding-agent
fi

step "Link dotfiles + submodules (./install)"
run "${BASEDIR}/install"

step "pi agent npm packages"
if [ -d "${HOME}/.pi/agent/npm/node_modules" ]; then
  echo "already installed"
else
  (cd "${HOME}/.pi/agent/npm" && run npm install)
fi

step "~/.zshrc.local"
if [ -e "${HOME}/.zshrc.local" ]; then
  echo "already exists"
else
  run cp "${BASEDIR}/.zshrc.local.example" "${HOME}/.zshrc.local"
  echo "created from .zshrc.local.example; fill in machine-specific values"
fi

printf '\nDone. Open a new terminal (or `exec zsh`) to load the config.\n'
