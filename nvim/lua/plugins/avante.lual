return {
  "yetone/avante.nvim",
  build = vim.fn.has("win32") ~= 0 and "powershell -ExecutionPolicy Bypass -File Build.ps1 -BuildFromSource false"
    or "make",
  event = "VeryLazy",
  opts = {
    provider = "copilot",
    selection = {
      hint_display = "inline",
    },
    behaviour = {
      auto_set_keymaps = false,
    },
  },
}
